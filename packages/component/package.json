{
  "name": "@leafage/component",
  "version": "1.3.7",
  "description": "The React Server Side Render Framework",
  "keywords": [
    "leafage",
    "react",
    "bundle"
  ],
  "homepage": "https://github.com/leafage-team/leafage",
  "license": "MIT",
  "author": "mingdev <mingdev@163.com>",
  "exports": {
    "./App": {
      "import": "./dist-esm/App.js",
      "default": "./dist-cjs/App.js"
    },
    "./Document": {
      "import": "./dist-esm/Document.js",
      "default": "./dist-cjs/Document.js"
    },
    "./Error": {
      "import": "./dist-esm/Error.js",
      "default": "./dist-cjs/Error.js"
    },
    "./RenderJudge": {
      "import": "./dist-esm/RenderJudge.js",
      "default": "./dist-cjs/RenderJudge.js"
    }
  },
  "main": "dist-cjs/index.js",
  "module": "dist-esm/index.js",
  "files": [
    "dist-cjs",
    "dist-esm"
  ],
  "dependencies": {
    "react-helmet": "^6.1.0"
  },
  "devDependencies": {
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "react": "^18.0.0"
  }
}
