{
  "name": "leafage",
  "version": "1.3.7",
  "description": "The React Server Side Render Framework",
  "keywords": [
    "leafage",
    "react",
    "bundle"
  ],
  "homepage": "https://github.com/leafage-team/leafage",
  "license": "MIT",
  "author": "mingdev <mingdev@163.com>",
  "exports": {
    ".": {
      "import": "./dist-esm/index.js",
      "default": "./dist-cjs/index.js"
    },
    "./component": {
      "import": "./dist-esm/client/component.js",
      "default": "./dist-cjs/client/component.js"
    }
  },
  "files": [
    "dist-cjs",
    "dist-esm"
  ],
  "dependencies": {
    "@leafage/component": "workspace:*",
    "@leafage/renderer": "workspace:*",
    "@leafage/rspack": "workspace:*",
    "@leafage/server": "workspace:*",
    "@leafage/toolkit": "workspace:*",
    "hookable": "^5.5.3"
  }
}
