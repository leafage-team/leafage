{
  "name": "leafage-monorepo",
  "version": "1.3.7",
  "private": true,
  "description": "The React Server Side Render Framework",
  "homepage": "https://github.com/leafage-team/leafage",
  "license": "MIT",
  "author": "mingdev <mingdev@163.com>",
  "scripts": {
    "build": "rollup --config rollup.config.js",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s",
    "clean:compiled-all": "rimraf ./packages/*/compiled/ -g",
    "clean:dist-all": "rimraf ./packages/*/{dist,dist-cjs,dist-esm}/ -g",
    "preinstall": "npx only-allow pnpm",
    "lint-staged": "lint-staged",
    "lint:eslint": "eslint --ext .js,.jsx packages examples",
    "prebundle": "pnpm -r --filter=./packages/* run prebundle",
    "prepare": "pnpm run prebundle",
    "release": "node scripts/release.js",
    "sort-package": "pnpx sort-package-json ./package.json ./packages/*/package.json"
  },
  "pre-commit": "lint-staged",
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "conventional-changelog-cli": "^5.0.0",
    "enquirer": "^2.4.1",
    "eslint": "^8.35.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "fast-glob": "^3.3.3",
    "lint-staged": "^13.1.2",
    "picocolors": "^1.1.1",
    "pre-commit": "^1.2.2",
    "prebundle": "^1.5.0",
    "rimraf": "^6.0.1",
    "rollup": "^4.45.1",
    "rollup-merge-config": "^0.0.12",
    "rollup-plugin-node-externals": "^8.0.1",
    "semver": "^7.7.2"
  },
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">= 24.0.0",
    "pnpm": ">= 10.22.0"
  }
}
